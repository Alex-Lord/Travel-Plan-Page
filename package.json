{
  "name": "ai-friendly-lightweight-travel-template",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "boundaries:sync": "node scripts/sync-boundaries.mjs",
    "boundaries:index": "node scripts/build-boundary-index.mjs",
    "boundaries:validate": "node scripts/validate-boundaries.mjs",
    "build:map": "node scripts/build-map.mjs --trip private/trip-data.json --out private/trip-data.json",
    "encrypt:trip": "node scripts/encrypt-trip-data.mjs",
    "validate": "node scripts/validate-lite.mjs --trip private/trip-data.json && node scripts/validate-encrypted-trip.mjs",
    "test:runtime": "node --test tests/runtime/runtime-storage.test.cjs",
    "preview": "node local-preview-server.mjs"
  }
}
